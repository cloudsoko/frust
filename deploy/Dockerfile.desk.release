# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim AS runtime

ARG FRUST_VERSION=0.1.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Frust Desk" \
      org.opencontainers.image.description="Frust server-rendered Desk" \
      org.opencontainers.image.version="${FRUST_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/cloudsoko/frust" \
      org.opencontainers.image.licenses="AGPL-3.0-only AND MIT"

RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 frust && \
    useradd --uid 10001 --gid frust --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin frust && \
    install -d /usr/share/licenses/frust-desk /usr/share/licenses/topcoat

COPY --from=payload --chmod=0755 bin/frust-desk /usr/local/bin/frust-desk
COPY --from=payload licenses/FRUST-DESK-AGPL-3.0.txt licenses/FRUST-DESK-NOTICE.txt /usr/share/licenses/frust-desk/
COPY --from=payload licenses/TOPCOAT-MIT.txt /usr/share/licenses/topcoat/LICENSE

USER 10001:10001
ENV HOST=0.0.0.0 \
    PORT=3000 \
    FRUST_KERNEL=http://kernel:8790
EXPOSE 3000

ENTRYPOINT ["frust-desk"]
