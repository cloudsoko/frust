# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.96.0
FROM rust:${RUST_VERSION}-bookworm AS build

ENV CARGO_NET_RETRY=10 \
    CARGO_HTTP_MULTIPLEXING=false \
    CARGO_HTTP_TIMEOUT=600

WORKDIR /src/frust-kernel
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/frust-kernel/target,sharing=locked \
    cargo build --locked --release --package frust-kernel && \
    install -Dm0755 target/release/frust /out/frust

FROM surrealdb/surrealdb:v3.2.4 AS surrealdb

FROM debian:bookworm-slim AS runtime

ARG FRUST_VERSION=0.1.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Frust kernel" \
      org.opencontainers.image.description="Frust metadata kernel and REST service" \
      org.opencontainers.image.version="${FRUST_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/cloudsoko/frust" \
      org.opencontainers.image.licenses="AGPL-3.0-only AND BUSL-1.1"

RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 frust && \
    useradd --uid 10001 --gid frust --home-dir /var/lib/frust --create-home --shell /usr/sbin/nologin frust && \
    install -d -o frust -g frust /opt/frust/artifacts /var/lib/frust/mail-outbox /var/lib/frust/recovery && \
    install -d /usr/share/licenses/frust /usr/share/licenses/surrealdb

COPY --from=build /out/frust /usr/local/bin/frust
COPY --from=surrealdb /surreal /usr/local/bin/surreal
COPY --from=artifacts --chown=frust:frust . /opt/frust/artifacts/
COPY --from=deploy --chmod=0755 bin/kernel-entrypoint.sh /usr/local/bin/kernel-entrypoint
COPY --from=legal LICENSE NOTICE /usr/share/licenses/frust/
COPY --from=deploy licenses/SURREALDB-BSL-1.1.txt /usr/share/licenses/surrealdb/LICENSE

USER 10001:10001
WORKDIR /var/lib/frust
ENV FRUST_ADDR=0.0.0.0:8790 \
    FRUST_ARTIFACTS=/opt/frust/artifacts \
    FRUST_SURREAL_BIN=/usr/local/bin/surreal \
    FRUST_MAIL=file \
    FRUST_MAIL_DIR=/var/lib/frust/mail-outbox
EXPOSE 8790

ENTRYPOINT ["kernel-entrypoint"]
CMD ["serve"]
